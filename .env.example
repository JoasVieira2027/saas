# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - SAAS MULTITENANT DE BELEZA
# ==============================================================================

# 1. Supabase (Backend & Banco de Dados)
# Obtenha no painel do Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. URLs da Aplicação e Domínio Raiz (Multitenant)
# Em desenvolvimento: http://localhost:3000 e localhost:3000
# Em produção (Vercel): https://meudominio.com.br e meudominio.com.br
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# 3. Chave Secreta para Assinatura Criptográfica de Sessão (HMAC-SHA256)
# Obrigatório em produção. Gere uma chave aleatória de alta entropia (mínimo 32 caracteres)
# Exemplo de comando no terminal: openssl rand -hex 32
SESSION_SECRET=your-random-session-secret-at-least-32-chars-long


